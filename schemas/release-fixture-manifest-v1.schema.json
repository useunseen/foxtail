{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://useunseen.dev/foxtail/schemas/release-fixture-manifest-v1.schema.json",
  "title": "Foxtail release qualification Fixture Manifest v1",
  "$defs": {
    "selector_free_value": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "finding_type": false
          },
          "additionalProperties": {
            "$ref": "#/$defs/selector_free_value"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector_free_value"
          }
        },
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "selector_free_object": {
      "type": "object",
      "properties": {
        "finding_type": false
      },
      "additionalProperties": {
        "$ref": "#/$defs/selector_free_value"
      }
    }
  },
  "type": "object",
  "required": [
    "schema",
    "definition",
    "generator",
    "environment",
    "clock",
    "generation",
    "ec2_instance_type_catalogue",
    "resources",
    "evidence_declarations",
    "control_catalogue",
    "fault_profiles",
    "mutation_generation",
    "mutation_generation_id",
    "mutation_resources",
    "digest"
  ],
  "properties": {
    "schema": {"const": "foxtail.release-fixture-manifest/v1"},
    "definition": {
      "type": "object",
      "required": ["name", "revision", "digest"],
      "properties": {
        "name": {"const": "release-qualification-v1"},
        "revision": {"const": "1.0.1"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": ["foxtail_version", "source_revision", "fixture_contract"],
      "properties": {
        "foxtail_version": {"type": "string"},
        "source_revision": {"type": "string"},
        "fixture_contract": {"const": "release-qualification-v1"}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "account_id",
        "region",
        "aws_endpoint_url",
        "localstack_version",
        "read_only_estate_fingerprint",
        "estate_fingerprint",
        "complete_resource_count"
      ],
      "properties": {
        "account_id": {"type": "string"},
        "region": {"type": "string"},
        "aws_endpoint_url": {"type": "string"},
        "localstack_version": {"type": "string"},
        "read_only_estate_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "estate_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "complete_resource_count": {"type": "integer", "minimum": 5}
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "required": ["anchor", "bucket", "required_history_days", "reusable_until"],
      "properties": {
        "anchor": {"type": "string", "format": "date-time"},
        "bucket": {"const": "complete-utc-day"},
        "required_history_days": {"type": "integer", "minimum": 1},
        "reusable_until": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "generation": {"type": "integer", "minimum": 1},
    "ec2_instance_type_catalogue": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "instance_type",
          "supported_root_device_types",
          "supported_virtualization_types",
          "supported_architectures",
          "ena_support"
        ],
        "properties": {
          "instance_type": {"type": "string", "minLength": 1},
          "supported_root_device_types": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "supported_virtualization_types": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "supported_architectures": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "ena_support": {"enum": ["required", "supported", "unsupported"]}
        },
        "additionalProperties": false
      }
    },
    "mutation_generation": {"type": ["integer", "null"], "minimum": 0},
    "mutation_generation_id": {"type": ["string", "null"], "pattern": "^mg-[0-9]{4,}$"},
    "resources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "role",
          "resource_id",
          "resource_type",
          "aws_identity",
          "scenario",
          "evidence",
          "observed"
        ],
        "properties": {
          "control_id": {"type": "string"},
          "role": {"enum": ["positive", "negative", "degraded", "mutation"]},
          "resource_id": {"type": "string"},
          "resource_type": {"const": "ec2"},
          "aws_identity": {"type": "string"},
          "scenario": {"type": "string"},
          "evidence": {
            "$ref": "#/$defs/selector_free_object",
            "patternProperties": {
              "^(Required|Stretch|required|stretch|expected_finding|expected_findings|authoritative_expected_finding|finding|finding_type)$": false
            },
            "additionalProperties": {
              "$ref": "#/$defs/selector_free_value"
            }
          },
          "observed": {
            "type": "object",
            "required": ["instance_state", "instance_type", "disable_api_termination", "availability_zone", "tags"],
            "properties": {
              "instance_state": {"enum": ["pending", "running", "stopped", "shutting-down", "terminated", "stopping"]},
              "instance_type": {"type": "string"},
              "disable_api_termination": {"type": "boolean"},
              "availability_zone": {"type": "string"},
              "tags": {
                "type": "object",
                "properties": {"finding_type": false},
                "additionalProperties": {"type": "string"}
              }
            },
            "patternProperties": {
              "^(Required|Stretch|required|stretch|expected_finding|expected_findings|authoritative_expected_finding|finding|finding_type)$": false
            },
            "additionalProperties": {
              "$ref": "#/$defs/selector_free_value"
            }
          }
        },
        "patternProperties": {
          "^(Required|Stretch|required|stretch|expected_finding|expected_findings|authoritative_expected_finding|finding|finding_type)$": false
        },
        "not": {
          "anyOf": [
            {"required": ["Required"]},
            {"required": ["Stretch"]},
            {"required": ["required"]},
            {"required": ["stretch"]},
            {"required": ["expected_finding"]},
            {"required": ["expected_findings"]},
            {"required": ["finding"]}
          ]
        },
        "additionalProperties": {
          "$ref": "#/$defs/selector_free_value"
        }
      }
    },
    "mutation_resources": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "target_kind",
          "setup_fault_kind",
          "resource_id",
          "aws_identity",
          "instance_state",
          "instance_type",
          "initial_state",
          "initial_type",
          "terminal_state",
          "terminal_type",
          "restored_state",
          "restored_type"
        ],
        "properties": {
          "control_id": {"type": "string"},
          "target_kind": {"enum": ["stop", "resize", "stop-recovery", "resize-restoration"]},
          "setup_fault_kind": {"enum": ["stop", "resize"]},
          "resource_id": {"type": "string"},
          "aws_identity": {"type": "string"},
          "instance_state": {"enum": ["running", "stopped"]},
          "instance_type": {"type": "string"},
          "initial_state": {"enum": ["running", "stopped"]},
          "initial_type": {"type": "string"},
          "terminal_state": {"enum": ["running", "stopped"]},
          "terminal_type": {"type": "string"},
          "restored_state": {"enum": ["running", "stopped"]},
          "restored_type": {"type": "string"},
          "external_status": {"type": "string"},
          "external_identity_verified": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "evidence_declarations": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "finding_type": false
        },
        "patternProperties": {
          "^(Required|Stretch|required|stretch|expected_finding|expected_findings|authoritative_expected_finding|finding|finding_type)$": false
        },
        "additionalProperties": {
          "$ref": "#/$defs/selector_free_value"
        }
      }
    },
    "control_catalogue": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["control_id", "role"],
        "properties": {
          "control_id": {"type": "string"},
          "role": {"enum": ["positive", "negative", "degraded", "mutation"]}
        },
        "patternProperties": {
          "^(Required|Stretch|required|stretch|expected_finding|expected_findings|authoritative_expected_finding|finding|finding_type)$": false
        },
        "not": {
          "anyOf": [
            {"required": ["Required"]},
            {"required": ["Stretch"]},
            {"required": ["required"]},
            {"required": ["stretch"]},
            {"required": ["expected_finding"]},
            {"required": ["expected_findings"]},
            {"required": ["finding"]}
          ]
        },
        "additionalProperties": {
          "$ref": "#/$defs/selector_free_value"
        }
      }
    },
    "fault_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_type": false
        },
        "patternProperties": {
          "^(Required|Stretch|required|stretch|expected_finding|expected_findings|authoritative_expected_finding|finding|finding_type)$": false
        },
        "additionalProperties": {
          "$ref": "#/$defs/selector_free_value"
        }
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "not": {
    "anyOf": [
      {"required": ["Required"]},
      {"required": ["Stretch"]},
      {"required": ["required"]},
      {"required": ["stretch"]},
      {"required": ["expected_finding"]},
      {"required": ["expected_findings"]},
      {"required": ["authoritative_expected_finding"]},
      {"required": ["finding"]}
    ]
  },
  "additionalProperties": false
}
